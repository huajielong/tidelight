# Choose exactly one: deepseek (default), seed, openai, local.
# Credentials stay on the server. Never put a key in src/ or index.html.
# Copy to .env.local, fill locally, then use Node 22+:
# node --env-file=.env.local scripts/serve.mjs --port 4317
AI_PROVIDER=deepseek

# DeepSeek official API. Override with your available model ID if needed.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Seed through Volcengine Ark (China/Beijing).
# Set AI_PROVIDER=seed and fill BOTH values from your Ark console.
# ARK_MODEL accepts a supported Seed Model ID or an ep-... Endpoint ID.
# Example model documented on 2026-10-19: doubao-seed-2-1-pro-260915.
ARK_API_KEY=
ARK_MODEL=

# Optional legacy provider, used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Netlify production only. Caps can be reduced (0 disables paid generation).
# Defaults / maximums: daily 100, monthly 1000. Asia/Shanghai calendar.
AI_DAILY_LIMIT=100
AI_MONTHLY_LIMIT=1000
